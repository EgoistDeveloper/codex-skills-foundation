{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EgoistDeveloper/codex-skills-foundation/main/schemas/completion-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "completion_status",
    "workspace",
    "items",
    "remaining_risks"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "completion_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "head_sha",
        "working_tree_reviewed"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "minLength": 7
        },
        "working_tree_reviewed": {
          "type": "boolean"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "status",
          "summary",
          "evidence"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "summary"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "command",
                    "inspection",
                    "runtime",
                    "artifact",
                    "decision"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The verifier command. For receipt-backed evidence this is the deterministic human-readable rendering of receipt child.argv, not the receipt-runner invocation."
                },
                "verifier_argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Exact child argv from the structured receipt. Required only for receipt-backed command evidence."
                },
                "fresh": {
                  "type": "boolean"
                },
                "exit_code": {
                  "type": "integer"
                },
                "artifact_path": {
                  "type": "string",
                  "minLength": 1
                },
                "receipt": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Identity of the trusted receipt-runner execution transport, kept separate from the child verifier command.",
                  "required": [
                    "run_id",
                    "command_id",
                    "payload_sha256",
                    "child_exit_code"
                  ],
                  "properties": {
                    "run_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "command_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "payload_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "child_exit_code": {
                      "type": "integer"
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "command"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "required": [
                      "command",
                      "fresh",
                      "exit_code"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "receipt"
                    ]
                  },
                  "then": {
                    "required": [
                      "verifier_argv"
                    ],
                    "properties": {
                      "type": {
                        "const": "command"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "verifier_argv"
                    ]
                  },
                  "then": {
                    "required": [
                      "receipt"
                    ],
                    "properties": {
                      "type": {
                        "const": "command"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "artifact"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "required": [
                      "artifact_path"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "remaining_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
