{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EgoistDeveloper/codex-skills-foundation/main/schemas/completion-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "completion_status",
    "items",
    "working_tree_reviewed",
    "remaining_risks"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "completion_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "status",
          "evidence"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "working_tree_reviewed": {
      "type": "boolean"
    },
    "remaining_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "completion_status": {
            "const": "COMPLETE"
          }
        },
        "required": [
          "completion_status"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "NOT_APPLICABLE"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
