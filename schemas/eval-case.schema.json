{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EgoistDeveloper/codex-skills-foundation/main/schemas/eval-case.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "package",
    "prompt",
    "expected_activation",
    "behavior_assertions",
    "risk"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "expected_activation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "forbidden_activation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "behavior_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "fixture": {
      "type": "string",
      "minLength": 1
    }
  }
}
