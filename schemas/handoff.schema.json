{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EgoistDeveloper/codex-skills-foundation/main/schemas/handoff.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "acceptance",
    "repository_state",
    "decisions",
    "completed",
    "evidence",
    "unresolved_risks",
    "next_action"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repository_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commit",
        "working_tree"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "working_tree": {
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        }
      }
    },
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "status",
          "artifact"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "artifact": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "artifact": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
