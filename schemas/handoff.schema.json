{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EgoistDeveloper/codex-skills-foundation/main/schemas/handoff.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "objective",
    "acceptance_status",
    "non_goals",
    "constraints",
    "repository_state",
    "decisions",
    "completed_work",
    "checks",
    "remaining_risks",
    "next_atomic_action",
    "resume_commands",
    "provenance"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_status": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repository_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "baseline_sha",
        "head_sha",
        "working_tree"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "baseline_sha": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "working_tree": {
          "type": "string"
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completed_work": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "summary"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "remaining_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_atomic_action": {
      "type": "string",
      "minLength": 1
    },
    "resume_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
