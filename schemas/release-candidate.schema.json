{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EgoistDeveloper/codex-skills-foundation/main/schemas/release-candidate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "subject_commit_sha",
    "intended_release_tag",
    "release_version",
    "candidate_state",
    "creation_contract",
    "catalog_sha256",
    "marketplace_identity",
    "packages",
    "checksums"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "subject_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "intended_release_tag": {"type": "string", "minLength": 1},
    "release_version": {"type": "string", "minLength": 1},
    "candidate_state": {"const": "UNRELEASED"},
    "creation_contract": {"const": "b02-h04r-v1"},
    "catalog_sha256": {"$ref": "#/$defs/sha256"},
    "marketplace_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openai_sha256", "claude_sha256"],
      "properties": {
        "openai_sha256": {"$ref": "#/$defs/sha256"},
        "claude_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "archive_filename",
          "sha256",
          "size_bytes",
          "skill_count",
          "content_sha256",
          "plugin_manifest_sha256",
          "provider_manifest_sha256",
          "verifier_runner_sha256"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "archive_filename": {"type": "string", "pattern": "^[^/\\\\]+\\.zip$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "skill_count": {"type": "integer", "minimum": 1},
          "content_sha256": {"$ref": "#/$defs/sha256"},
          "plugin_manifest_sha256": {"$ref": "#/$defs/sha256"},
          "provider_manifest_sha256": {
            "type": "object",
            "additionalProperties": false,
            "required": ["codex", "claude"],
            "properties": {
              "codex": {"$ref": "#/$defs/sha256"},
              "claude": {"$ref": "#/$defs/sha256"}
            }
          },
          "verifier_runner_sha256": {
            "oneOf": [
              {"$ref": "#/$defs/sha256"},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "size_bytes"],
      "properties": {
        "filename": {"const": "SHA256SUMS"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
